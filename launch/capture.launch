<launch>
  <arg name="enabled" default="true"/>
  <arg name="spool_dir" default="/workspace/catkin_ws/data/capture_spool"/>
  <arg name="ingest_ip" default="192.168.50.2"/>
  <arg name="ingest_port" default="8080"/>
  <arg name="api_key" default=""/>
  <arg name="jpeg_quality" default="90"/>
  <arg name="poll_interval_s" default="30"/>
  <arg name="auto_capture" default="true"/>
  <arg name="nav_sample_hz" default="0.5"/>
  <arg name="person_capture" default="true"/>
  <arg name="person_sample_hz" default="1.0"/>
  <arg name="person_tail_seconds" default="5.0"/>
  <arg name="person_min_confidence" default="0.5"/>
  <arg name="pose_spool_dir" default="/workspace/catkin_ws/data/pose_spool"/>
  <arg name="detection_spool_dir" default="/workspace/catkin_ws/data/detection_spool"/>
  <arg name="moving_sample_hz" default="2.0"/>
  <arg name="static_sample_hz" default="0.0167"/>
  <arg name="detection_min_confidence" default="0.6"/>
  <arg name="detection_sample_hz" default="2.0"/>
  <arg name="require_localized" default="true"/>
  <arg name="tall" default="false"/>
  <arg name="archive_dir" default="/workspace/catkin_ws/data/upload_archive"/>
  <arg name="retain_after_upload" default="true"/>
  <arg name="chunk_hours" default="1.0"/>

  <group if="$(arg enabled)">
    <node pkg="mattbot_capture" type="capture_node.py" name="capture_node" output="screen">
      <param name="spool_dir" value="$(arg spool_dir)"/>
      <param name="jpeg_quality" value="$(arg jpeg_quality)"/>
      <param name="tall" value="$(arg tall)"/>
      <param name="capture_ir" value="true"/>
      <param name="ir_image_topic" value="/camera/ir/image_raw"/>
      <param name="capture_depth" value="true"/>
      <param name="depth_image_topic" value="/camera/depth/image_raw"/>
    </node>

    <node pkg="mattbot_capture" type="capture_uploader.py" name="capture_uploader" output="screen">
      <param name="spool_dir" value="$(arg spool_dir)"/>
      <param name="archive_dir" value="$(arg archive_dir)"/>
      <param name="retain_after_upload" value="$(arg retain_after_upload)"/>
      <param name="ingest_ip" value="$(arg ingest_ip)"/>
      <param name="ingest_port" value="$(arg ingest_port)"/>
      <param name="api_key" value="$(arg api_key)"/>
      <param name="poll_interval_s" value="$(arg poll_interval_s)"/>
    </node>

    <node pkg="mattbot_capture" type="capture_auto_trigger.py" name="capture_auto_trigger" output="screen">
      <param name="auto_capture_enabled" value="$(arg auto_capture)"/>
      <param name="nav_sample_hz" value="$(arg nav_sample_hz)"/>
      <param name="person_capture_enabled" value="$(arg person_capture)"/>
      <param name="person_sample_hz" value="$(arg person_sample_hz)"/>
      <param name="person_tail_seconds" value="$(arg person_tail_seconds)"/>
      <param name="person_min_confidence" value="$(arg person_min_confidence)"/>
      <rosparam param="nav_capture_modes">[3, 4, 5, 6, 7, 10, 11]</rosparam>
    </node>

    <node pkg="mattbot_capture" type="pose_logger.py" name="pose_logger" output="screen">
      <param name="pose_spool_dir" value="$(arg pose_spool_dir)"/>
      <param name="moving_sample_hz" value="$(arg moving_sample_hz)"/>
      <param name="static_sample_hz" value="$(arg static_sample_hz)"/>
      <param name="chunk_hours" value="$(arg chunk_hours)"/>
      <param name="require_localized" value="$(arg require_localized)"/>
    </node>

    <node pkg="mattbot_capture" type="pose_uploader.py" name="pose_uploader" output="screen">
      <param name="pose_spool_dir" value="$(arg pose_spool_dir)"/>
      <param name="archive_dir" value="$(arg archive_dir)"/>
      <param name="retain_after_upload" value="$(arg retain_after_upload)"/>
      <param name="ingest_ip" value="$(arg ingest_ip)"/>
      <param name="ingest_port" value="$(arg ingest_port)"/>
      <param name="api_key" value="$(arg api_key)"/>
      <param name="poll_interval_s" value="$(arg poll_interval_s)"/>
    </node>

    <node pkg="mattbot_capture" type="detection_logger.py" name="detection_logger" output="screen">
      <param name="detection_spool_dir" value="$(arg detection_spool_dir)"/>
      <param name="min_confidence" value="$(arg detection_min_confidence)"/>
      <param name="sample_hz" value="$(arg detection_sample_hz)"/>
      <param name="chunk_hours" value="$(arg chunk_hours)"/>
      <param name="require_localized" value="$(arg require_localized)"/>
    </node>

    <node pkg="mattbot_capture" type="detection_uploader.py" name="detection_uploader" output="screen">
      <param name="detection_spool_dir" value="$(arg detection_spool_dir)"/>
      <param name="archive_dir" value="$(arg archive_dir)"/>
      <param name="retain_after_upload" value="$(arg retain_after_upload)"/>
      <param name="ingest_ip" value="$(arg ingest_ip)"/>
      <param name="ingest_port" value="$(arg ingest_port)"/>
      <param name="api_key" value="$(arg api_key)"/>
      <param name="poll_interval_s" value="$(arg poll_interval_s)"/>
    </node>
  </group>
</launch>
